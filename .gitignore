# --- Python bytecode / caches ---
__pycache__/
*.py[cod]
*$py.class

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Packaging / build artifacts ---
build/
dist/
*.egg-info/
*.egg
wheels/

# --- Test / tool caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/

# --- Jupyter ---
.ipynb_checkpoints/

# --- macOS ---
.DS_Store

# --- IDE / editor metadata ---
.vscode/
.idea/
*.swp

# --- Environment / secrets ---
.env
.env.*
*.secret
secrets.json
credentials.json

# --- Data ---
# data/raw and data/processed are intentional project structure (see
# docs/ARCHITECTURE.md). Keep directory placeholders (.gitkeep) tracked,
# but never commit actual raw or generated datasets.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
